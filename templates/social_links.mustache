{{!
    @template theme_nextgen/social_links

    Social profile links. Icons only unless showlabels is set.

    Example context (json):
    {
        "variant": "footer",
        "showlabels": false,
        "social": [
            {"network": "facebook", "label": "Facebook", "url": "https://www.facebook.com/", "handle": "",
             "arialabel": "Follow NextGen on Facebook", "isfacebook": true}
        ]
    }
}}
<ul class="ng-social-links ng-social-links-{{variant}}">
    {{#social}}
        <li>
            <a class="ng-social-link ng-social-{{network}}" href="{{url}}" target="_blank" rel="noopener noreferrer"
                {{^showlabels}}aria-label="{{arialabel}}" title="{{label}}"{{/showlabels}}>
                <span class="ng-social-mark" aria-hidden="true">{{> theme_nextgen/social_icon }}</span>
                {{#showlabels}}
                    <span class="ng-social-text">
                        <span class="ng-social-name">{{label}}</span>
                        {{#handle}}<span class="ng-social-handle">{{handle}}</span>{{/handle}}
                    </span>
                    <span class="ng-social-arrow" aria-hidden="true">
                        <svg viewBox="0 0 20 20" width="16" height="16" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 13l6-6M8 7h5v5"/></svg>
                    </span>
                {{/showlabels}}
            </a>
        </li>
    {{/social}}
</ul>
