{{!
    @template theme_boost/footer

    NextGen footer. Marketing columns come from the theme renderer.
    Moodle's login info, support links, hooks, and debug output stay in place.
}}
<footer id="page-footer" class="ng-footer tw:bg-secondary tw:antialiased">
    {{{ output.nextgen_footer_columns }}}

    <div class="ng-footer-meta">
        <div class="ng-footer-meta-inner">
            {{#output.has_communication_links}}
                <div class="ng-footer-support">{{{ output.communication_link }}}</div>
            {{/output.has_communication_links}}
            {{# output.page_doc_link }}
                <div class="ng-footer-support">{{{ output.page_doc_link }}}</div>
            {{/ output.page_doc_link }}
            {{# output.services_support_link }}
                <div class="ng-footer-support">{{{ output.services_support_link }}}</div>
            {{/ output.services_support_link }}
            {{# output.supportemail }}
                <div class="ng-footer-support">{{{ output.supportemail }}}</div>
            {{/ output.supportemail }}
            {{{ output.login_info }}}
            <div class="tool_usertours-resettourcontainer"></div>
            {{# output.telemetry_traceid }}
                <div>
                    <span id="telemetry_traceid" class="d-none">{{{ output.telemetry_traceid }}}</span>
                    <a href="#" data-action="copytoclipboard" data-clipboard-target="#telemetry_traceid"
                            data-clipboard-success-message="{{#str}}telemetrytraceidfooterlinkcopied, core{{/str}}">
                        {{#str}}telemetrytraceidfooterlink, core{{/str}}
                    </a>
                </div>
            {{/ output.telemetry_traceid }}
            {{{ output.standard_footer_html }}}
            {{{ output.standard_end_of_body_html }}}
            <div class="ng-footer-powered">{{#str}}poweredby, theme_nextgen{{/str}} <a href="https://cumisolutions.io/en">{{#str}}poweredbylink, theme_nextgen{{/str}}</a></div>
            {{#output.moodle_release}}
                <div class="ng-footer-powered">{{#str}}version, core{{/str}} {{{ output.moodle_release }}}</div>
            {{/output.moodle_release}}
        </div>
    </div>

    <div class="footer-content-debugging">
        {{{ output.debug_footer_html }}}
    </div>
</footer>
{{#js}}
require(['core/copy_to_clipboard'], function() {
});
{{/js}}
