{{!
    @template theme_boost/navbar

    NextGen header. Keeps Boost's primary navigation, search, edit switch,
    messaging, and user menu so core behaviour stays intact.
}}
<nav class="navbar fixed-top navbar-expand ng-header" aria-label="{{#str}}sitemenubar, admin{{/str}}">
    <div class="container-fluid ng-header-inner">
        <button class="navbar-toggler aabtn d-block d-md-none ng-header-toggler" data-toggler="drawers" data-action="toggle" data-target="theme_boost-drawers-primary">
            <span class="navbar-toggler-icon"></span>
            <span class="visually-hidden">{{#str}}sidepanel, core{{/str}}</span>
        </button>

        <a href="{{{ config.homeurl }}}" class="navbar-brand ng-brand aabtn">
            <img src="{{output.get_compact_logo_url}}" class="ng-brand-mark" alt="">
            <span class="ng-brand-name">{{{ sitename }}}</span>
        </a>

        {{#primarymoremenu}}
            <div class="primary-navigation ng-primary-nav">
                {{> core/moremenu}}
            </div>
        {{/primarymoremenu}}

        {{# output.page_heading_menu}}
            <ul class="navbar-nav d-none d-md-flex my-1 px-1">
                {{{ output.page_heading_menu }}}
            </ul>
        {{/output.page_heading_menu}}

        <div id="usernavigation" class="navbar-nav ms-auto ng-user-nav">
            {{# output.search_box }}
                <div class="ng-header-search">
                    {{{ output.search_box }}}
                </div>
            {{/output.search_box}}
            {{#langmenu}}
                {{> theme_boost/language_menu }}
            {{/langmenu}}
            {{{ output.edit_switch }}}
            {{# output.navbar_plugin_output }}
                {{{ . }}}
            {{/output.navbar_plugin_output}}
            {{#usermenu}}
                <div class="d-flex align-items-stretch usermenu-container" data-region="usermenu">
                    {{> core/user_menu }}
                </div>
            {{/usermenu}}
        </div>
    </div>
</nav>

{{> theme_boost/primary-drawer-mobile }}
