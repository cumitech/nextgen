{{!
    @template theme_nextgen/dashboard

    Signed-in home. Hero, greeting, and course counts.
    Course blocks below this stay on Moodle's own overview.
}}
<div class="ng-dash">
    <header class="ng-dash-hero{{#systemdashboard}} ng-dash-hero-system{{/systemdashboard}}">
        {{{ output.full_header }}}
        <svg class="ng-dash-hero-hills" viewBox="0 0 960 240" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <path class="ng-dash-hill ng-dash-hill-back" d="M520 150c70-48 140-48 220-18 50 18 90 18 140 4 40-12 70-28 80-36v140H520z"/>
            <path class="ng-dash-hill ng-dash-hill-mid" d="M430 176c80-36 150-20 230 8 60 20 120 16 180-8 40-16 80-36 120-40v104H430z"/>
            <path class="ng-dash-hill ng-dash-hill-front" d="M360 198c90-24 160-8 250 16 70 18 140 10 210-12 50-16 90-28 140-24v62H360z"/>
        </svg>
    </header>
    <div class="ng-dash-grid">
        <section class="ng-dash-card">
            <h2>{{hello}}</h2>
            <p>{{today}}</p>
            {{#haslastlogin}}
                <p>{{lastlogin}}</p>
            {{/haslastlogin}}
            {{#hasrecent}}
                <p>
                    {{#str}}dashboardrecent, theme_nextgen{{/str}}
                    <a href="{{recenturl}}">{{recentname}}</a>
                </p>
            {{/hasrecent}}
            <p class="ng-dash-action">
                <a class="btn btn-primary" href="{{continueurl}}">{{#str}}dashboardcontinue, theme_nextgen{{/str}}</a>
            </p>
        </section>
        <section class="ng-dash-card" aria-label="{{#str}}dashboardmycourses, theme_nextgen{{/str}}">
            <h2>{{#str}}dashboardmycourses, theme_nextgen{{/str}}</h2>
            <ul class="ng-dash-counts">
                <li>
                    <span class="ng-dash-count">{{allcount}}</span>
                    <span>{{#str}}dashboardall, theme_nextgen{{/str}}</span>
                </li>
                <li>
                    <span class="ng-dash-count">{{inprogresscount}}</span>
                    <span>{{#str}}dashboardinprogress, theme_nextgen{{/str}}</span>
                </li>
                <li>
                    <span class="ng-dash-count">{{pastcount}}</span>
                    <span>{{#str}}dashboardpast, theme_nextgen{{/str}}</span>
                </li>
            </ul>
        </section>
    </div>
    {{#showbadges}}
        <section class="ng-dash-achievements" aria-labelledby="ng-dash-achievements-title">
            <div class="ng-dash-section-heading">
                <div>
                    <p class="ng-dash-eyebrow">{{#str}}dashboardachievementeyebrow, theme_nextgen{{/str}}</p>
                    <h2 id="ng-dash-achievements-title">{{#str}}dashboardachievements, theme_nextgen{{/str}}</h2>
                </div>
                <a href="{{badgesmyurl}}">{{#str}}dashboardallbadges, theme_nextgen{{/str}}</a>
            </div>
            {{#hasbadges}}
                <ul class="ng-dash-trophies">
                    {{#badges}}
                        <li>
                            <a class="ng-dash-trophy" href="{{url}}">
                                <span class="ng-dash-trophy-art">
                                    <img src="{{imageurl}}" alt="{{name}}" loading="lazy">
                                </span>
                                <span class="ng-dash-trophy-name">{{name}}</span>
                                <span class="ng-dash-trophy-date">{{issued}}</span>
                            </a>
                        </li>
                    {{/badges}}
                </ul>
            {{/hasbadges}}
            {{^hasbadges}}
                <p class="ng-dash-achievements-empty">{{#str}}dashboardbadgesempty, theme_nextgen{{/str}}</p>
            {{/hasbadges}}
        </section>
    {{/showbadges}}
    {{#hascertificates}}
        <section class="ng-dash-certificates" aria-labelledby="ng-dash-certificates-title">
            <div class="ng-dash-section-heading">
                <div>
                    <p class="ng-dash-eyebrow">{{#str}}dashboardcertificateeyebrow, theme_nextgen{{/str}}</p>
                    <h2 id="ng-dash-certificates-title">{{#str}}dashboardcertificates, theme_nextgen{{/str}}</h2>
                </div>
                <a href="{{allcertificatesurl}}">{{#str}}dashboardallcertificates, theme_nextgen{{/str}}</a>
            </div>
            <ul class="ng-dash-certificate-list">
                {{#mycertificates}}
                    <li class="ng-dash-certificate">
                        <div class="ng-dash-certificate-info">
                            <h3>{{name}}</h3>
                            {{#hascourse}}<p>{{coursename}}</p>{{/hascourse}}
                            <p class="ng-dash-certificate-issued">{{issued}}</p>
                        </div>
                        <div class="ng-dash-certificate-actions">
                            <a class="btn btn-primary btn-sm" href="{{downloadurl}}" target="_blank" rel="noopener">{{#str}}dashboardcertificatedownload, theme_nextgen{{/str}}</a>
                            <a class="btn btn-outline-secondary btn-sm" href="{{verifyurl}}" target="_blank" rel="noopener">{{#str}}dashboardcertificateverify, theme_nextgen{{/str}}</a>
                            <span class="ng-dash-certificate-share-label">{{#str}}dashboardcertificateshare, theme_nextgen{{/str}}</span>
                            <a href="{{facebookurl}}" target="_blank" rel="noopener noreferrer">{{#str}}dashboardsharefacebook, theme_nextgen{{/str}}</a>
                            <a href="{{linkedinurl}}" target="_blank" rel="noopener noreferrer">{{#str}}dashboardsharelinkedin, theme_nextgen{{/str}}</a>
                            <a href="{{xurl}}" target="_blank" rel="noopener noreferrer">{{#str}}dashboardsharex, theme_nextgen{{/str}}</a>
                        </div>
                    </li>
                {{/mycertificates}}
            </ul>
        </section>
    {{/hascertificates}}
</div>
