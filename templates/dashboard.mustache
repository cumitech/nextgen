{{!
    @template theme_nextgen/dashboard

    Signed-in home. Greeting, last course, and course counts.
    Course blocks below this stay on Moodle's own overview.
}}
<div class="ng-dash">
    <div class="ng-dash-grid">
        <section class="ng-dash-card">
            <h1>{{hello}}</h1>
            <p>{{today}}</p>
            {{#haslastlogin}}
                <p>{{lastlogin}}</p>
            {{/haslastlogin}}
            {{#hasrecent}}
                <p>
                    {{#str}}dashboardrecent, theme_nextgen{{/str}}
                    <a href="{{recenturl}}">{{recentname}}</a>
                </p>
            {{/hasrecent}}
            <p class="ng-dash-action">
                <a class="btn btn-primary" href="{{continueurl}}">{{#str}}dashboardcontinue, theme_nextgen{{/str}}</a>
            </p>
        </section>
        <section class="ng-dash-card" aria-label="{{#str}}dashboardmycourses, theme_nextgen{{/str}}">
            <h2>{{#str}}dashboardmycourses, theme_nextgen{{/str}}</h2>
            <ul class="ng-dash-counts">
                <li>
                    <span class="ng-dash-count">{{allcount}}</span>
                    <span>{{#str}}dashboardall, theme_nextgen{{/str}}</span>
                </li>
                <li>
                    <span class="ng-dash-count">{{inprogresscount}}</span>
                    <span>{{#str}}dashboardinprogress, theme_nextgen{{/str}}</span>
                </li>
                <li>
                    <span class="ng-dash-count">{{pastcount}}</span>
                    <span>{{#str}}dashboardpast, theme_nextgen{{/str}}</span>
                </li>
            </ul>
        </section>
    </div>
</div>
