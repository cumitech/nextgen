{{!
    @template theme_nextgen/dashboard

    Signed-in dashboard hero, welcome card, and course counts.
}}
<div class="ng-dash">
    <header class="ng-dash-hero tw:relative tw:overflow-hidden tw:bg-secondary tw:text-white">
        <div class="ng-dash-hero-tiles" aria-hidden="true"></div>
        <svg class="ng-dash-hero-hills" viewBox="0 0 960 240" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
            <path class="ng-dash-hill ng-dash-hill-back" d="M520 150c70-48 140-48 220-18 50 18 90 18 140 4 40-12 70-28 80-36v140H520z"/>
            <path class="ng-dash-hill ng-dash-hill-mid" d="M430 176c80-36 150-20 230 8 60 20 120 16 180-8 40-16 80-36 120-40v104H430z"/>
            <path class="ng-dash-hill ng-dash-hill-front" d="M360 198c90-24 160-8 250 16 70 18 140 10 210-12 50-16 90-28 140-24v62H360z"/>
        </svg>
        <div class="tw:relative tw:mx-auto tw:flex tw:min-h-44 tw:max-w-[76rem] tw:items-end tw:px-6 tw:pb-16 tw:pt-8 tw:md:min-h-52">
            <h1 class="tw:m-0 tw:text-4xl tw:font-bold tw:tracking-tight tw:text-white">{{title}}</h1>
        </div>
    </header>
    <div class="ng-dash-grid tw:relative tw:z-10 tw:mx-auto tw:-mt-10 tw:mb-6 tw:max-w-[76rem] tw:px-6">
        <section class="tw:rounded-2xl tw:border tw:border-border tw:bg-surface tw:p-6 tw:shadow-sm">
            <h2 class="tw:m-0 tw:text-xl tw:font-bold tw:text-text">{{hello}}</h2>
            <p class="tw:mt-4 tw:mb-0 tw:text-sm tw:leading-6 tw:text-text-muted">{{today}}</p>
            {{#haslastlogin}}
                <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:leading-6 tw:text-text-muted">{{lastlogin}}</p>
            {{/haslastlogin}}
            {{#hasrecent}}
                <p class="tw:mt-1 tw:mb-0 tw:text-sm tw:leading-6 tw:text-text-muted">
                    {{#str}}dashboardrecent, theme_nextgen{{/str}}
                    <a class="tw:font-semibold tw:text-primary tw:no-underline tw:hover:underline" href="{{recenturl}}">{{recentname}}</a>
                </p>
            {{/hasrecent}}
            <p class="tw:mt-5 tw:mb-0">
                <a class="btn btn-primary" href="{{continueurl}}">{{#str}}dashboardcontinue, theme_nextgen{{/str}}</a>
            </p>
        </section>
        <section class="tw:rounded-2xl tw:border tw:border-border tw:bg-surface tw:p-6 tw:shadow-sm" aria-label="{{#str}}dashboardmycourses, theme_nextgen{{/str}}">
            <h2 class="tw:m-0 tw:text-lg tw:font-bold tw:text-text">{{#str}}dashboardmycourses, theme_nextgen{{/str}}</h2>
            <div class="ng-dash-rings tw:mt-5">
                <div class="tw:flex tw:flex-col tw:items-center tw:gap-2">
                    <div class="ng-dash-ring-wrap">
                        <svg viewBox="0 0 120 120" aria-hidden="true">
                            <circle cx="60" cy="60" r="46" class="ng-dash-ring-track"></circle>
                            <circle cx="60" cy="60" r="46" class="ng-dash-ring ng-dash-ring-all" stroke-dasharray="{{circumference}}" stroke-dashoffset="{{alloffset}}"></circle>
                        </svg>
                        <span class="ng-dash-ring-value">{{allcount}}</span>
                    </div>
                    <span class="tw:text-xs tw:font-medium tw:text-text-muted tw:sm:text-sm">{{#str}}dashboardall, theme_nextgen{{/str}}</span>
                </div>
                <div class="tw:flex tw:flex-col tw:items-center tw:gap-2">
                    <div class="ng-dash-ring-wrap">
                        <svg viewBox="0 0 120 120" aria-hidden="true">
                            <circle cx="60" cy="60" r="46" class="ng-dash-ring-track"></circle>
                            <circle cx="60" cy="60" r="46" class="ng-dash-ring ng-dash-ring-progress" stroke-dasharray="{{circumference}}" stroke-dashoffset="{{inprogressoffset}}"></circle>
                        </svg>
                        <span class="ng-dash-ring-value">{{inprogresscount}}</span>
                    </div>
                    <span class="tw:text-xs tw:font-medium tw:text-text-muted tw:sm:text-sm">{{#str}}dashboardinprogress, theme_nextgen{{/str}}</span>
                </div>
                <div class="tw:flex tw:flex-col tw:items-center tw:gap-2">
                    <div class="ng-dash-ring-wrap">
                        <svg viewBox="0 0 120 120" aria-hidden="true">
                            <circle cx="60" cy="60" r="46" class="ng-dash-ring-track"></circle>
                            <circle cx="60" cy="60" r="46" class="ng-dash-ring ng-dash-ring-past" stroke-dasharray="{{circumference}}" stroke-dashoffset="{{pastoffset}}"></circle>
                        </svg>
                        <span class="ng-dash-ring-value">{{pastcount}}</span>
                    </div>
                    <span class="tw:text-xs tw:font-medium tw:text-text-muted tw:sm:text-sm">{{#str}}dashboardpast, theme_nextgen{{/str}}</span>
                </div>
            </div>
        </section>
    </div>
</div>
