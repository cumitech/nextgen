{{!
    @template enrol_fee/enrol_page

    Fee enrolment cost line for the NextGen checkout page.
}}
<p class="ng-enrol-fee-cost">
    <span class="ng-enrol-fee-label">{{#str}}cost{{/str}}</span>
    <span class="ng-enrol-fee-value">{{cost}}</span>
</p>
<p class="ng-enrol-fee-note">{{#str}}checkoutfeenote, theme_nextgen{{/str}}</p>
<p class="ng-enrol-fee-methods">{{#str}}checkoutpaymethods, theme_nextgen{{/str}}</p>
