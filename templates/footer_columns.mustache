{{!
    @template theme_nextgen/footer_columns

    Configurable footer columns.
}}
<div class="ng-footer-main">
    <div class="ng-footer-grid">
        <div class="ng-footer-brand">
            <a class="ng-footer-brand-link" href="{{{config.homeurl}}}">
                <img src="{{logourl}}" class="ng-footer-logo" alt="">
                <span class="ng-footer-name">{{#str}}pluginname, theme_nextgen{{/str}}</span>
            </a>
            {{#hascontact}}
                <h2 class="ng-footer-heading">{{#str}}footercontact, theme_nextgen{{/str}}</h2>
                <ul class="ng-footer-links">
                    {{#contactemail}}
                        <li><a href="mailto:{{contactemail}}">{{contactemail}}</a></li>
                    {{/contactemail}}
                    {{#contactphone}}
                        <li>
                            {{#contactphonehref}}
                                <a href="tel:{{contactphonehref}}">{{contactphone}}</a>
                            {{/contactphonehref}}
                            {{^contactphonehref}}
                                {{contactphone}}
                            {{/contactphonehref}}
                        </li>
                    {{/contactphone}}
                </ul>
            {{/hascontact}}
        </div>
        {{#columns}}
            <div class="ng-footer-col">
                <h2 class="ng-footer-heading">{{title}}</h2>
                <ul class="ng-footer-links">
                    {{#links}}
                        <li>
                            <a href="{{url}}" {{#external}}target="_blank" rel="noopener noreferrer"{{/external}}>{{label}}</a>
                        </li>
                    {{/links}}
                </ul>
            </div>
        {{/columns}}
        {{#hassocial}}
            <div class="ng-footer-col">
                <h2 class="ng-footer-heading">{{#str}}footersocial, theme_nextgen{{/str}}</h2>
                <ul class="ng-social-list">
                    {{#social}}
                        <li>
                            <a class="ng-social" href="{{url}}" target="_blank" rel="noopener noreferrer">
                                <span class="ng-social-icon" aria-hidden="true">
                                    {{#isfacebook}}
                                        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.6l.4-3H13v-2c0-.6.4-1 1-1z"/></svg>
                                    {{/isfacebook}}
                                    {{#isinstagram}}
                                        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 2A1.8 1.8 0 1 0 13.8 12 1.8 1.8 0 0 0 12 10.2zM17.2 6.8a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"/></svg>
                                    {{/isinstagram}}
                                    {{#islinkedin}}
                                        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M6.5 9H4V20h2.5zM5.2 4A1.6 1.6 0 1 0 5.2 7.2 1.6 1.6 0 0 0 5.2 4zM20 20h-2.5v-5.6c0-1.6-.6-2.6-2-2.6a2.2 2.2 0 0 0-2 1.5 2 2 0 0 0-.1.9V20H11V9h2.4v1.5A3 3 0 0 1 16.2 9c2.2 0 3.8 1.4 3.8 4.5z"/></svg>
                                    {{/islinkedin}}
                                    {{#isyoutube}}
                                        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M23 12.2s0-3.2-.4-4.6a3 3 0 0 0-2.1-2.1C18.9 5 12 5 12 5s-6.9 0-8.5.5a3 3 0 0 0-2.1 2.1C1 9 1 12.2 1 12.2s0 3.2.4 4.6a3 3 0 0 0 2.1 2.1C5.1 19.4 12 19.4 12 19.4s6.9 0 8.5-.5a3 3 0 0 0 2.1-2.1c.4-1.4.4-4.6.4-4.6zM9.8 15.5v-6.6l6.3 3.3z"/></svg>
                                    {{/isyoutube}}
                                    {{#isx}}
                                        <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M17.5 3h3.1l-6.8 7.8L22 21h-6.2l-4.8-6.3L6 21H2.8l7.3-8.4L2 3h6.3l4.4 5.8zm-1.1 16.2h1.7L7.7 4.7H5.9z"/></svg>
                                    {{/isx}}
                                </span>
                                <span>{{label}}</span>
                            </a>
                        </li>
                    {{/social}}
                </ul>
            </div>
        {{/hassocial}}
    </div>
    <div class="ng-footer-bar">
        <p>{{copyright}}</p>
        <ul class="ng-footer-policies">
            {{#privacyurl}}
                <li><a href="{{privacyurl}}">{{#str}}privacytitle, theme_nextgen{{/str}}</a></li>
            {{/privacyurl}}
            {{#termsurl}}
                <li><a href="{{termsurl}}">{{#str}}termstitle, theme_nextgen{{/str}}</a></li>
            {{/termsurl}}
        </ul>
    </div>
</div>
