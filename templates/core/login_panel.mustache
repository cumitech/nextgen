{{!
    @template core/login_panel

    Photo card beside the login and signup forms. Site auth instructions replace the default copy when set.
}}
<div class="login-layout-left-content ng-login-panel">
    <div class="ng-login-panel-copy">
        {{^leftinstructions}}
            <p class="ng-login-title">{{#str}}logintitle, theme_nextgen{{/str}}</p>
            <p class="ng-login-copy">{{#str}}logindescription, theme_nextgen{{/str}}</p>
        {{/leftinstructions}}
        {{#leftinstructions}}
            <div class="ng-login-instructions">{{{leftinstructions}}}</div>
        {{/leftinstructions}}
        <div class="ng-login-social">{{{ output.nextgen_social_links }}}</div>
    </div>
</div>
