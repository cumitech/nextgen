{{!
    @template core/login_panel

    Login panel copy. Site auth instructions replace the default message when set.
}}
<div class="login-layout-left-content ng-login-panel">
    {{^leftinstructions}}
        <div>
            <span class="ng-login-accent" aria-hidden="true"></span>
            <h1 class="ng-login-title">{{#str}}logintitle, theme_nextgen{{/str}}</h1>
            <p class="ng-login-copy">{{#str}}logindescription, theme_nextgen{{/str}}</p>
        </div>
        <p class="ng-login-actions">
            <a class="ng-login-browse" href="{{config.wwwroot}}/course/index.php">{{#str}}authbrowse, theme_nextgen{{/str}}</a>
        </p>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="ng-login-instructions">{{{leftinstructions}}}</div>
    {{/leftinstructions}}
</div>
