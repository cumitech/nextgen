{{!
    @template core/signup_form_layout

    NextGen signup page: shares the welcome line and Login/Register switch with the login form.

    Example context (json):
    {
        "logourl": "https://moodle.org/logo/moodle-logo.svg",
        "sitename": "Site name",
        "formhtml": "<p>(Form html would go here)</p>"
    }
}}
<div class="signupform ng-auth-form">
    {{#logourl}}
        <div id="loginlogo" class="ng-auth-logo">
            <img id="logoimage" src="{{logourl}}" class="ng-brand-mark" alt="{{sitename}}"/>
        </div>
    {{/logourl}}
    <p class="ng-auth-welcome">{{#str}}authwelcome, theme_nextgen, {{sitename}}{{/str}}</p>
    <nav class="ng-auth-switch" aria-label="{{#str}}authswitchlabel, theme_nextgen{{/str}}">
        <a class="ng-auth-switch-link" href="{{config.wwwroot}}/login/index.php">{{#str}}authswitchlogin, theme_nextgen{{/str}}</a>
        <a class="ng-auth-switch-link active" href="{{config.wwwroot}}/login/signup.php" aria-current="page">{{#str}}authswitchregister, theme_nextgen{{/str}}</a>
    </nav>
    <h1 class="ng-auth-heading login-heading">{{#str}}authsignupheading, theme_nextgen{{/str}}</h1>
    <p class="ng-auth-lead">{{#str}}authsignuplead, theme_nextgen{{/str}}</p>
    {{{formhtml}}}
</div>
