{{!
    @template theme_nextgen/showmore

    Long content that collapses behind a "Show more" toggle.

    The toggle stays hidden until theme_nextgen/showmore measures the content,
    so short content and pages without JavaScript show everything.

    Blocks:
    * modifier - ng-showmore-sm or ng-showmore-lg to change the collapsed height.
    * content - the content to collapse.

    Example context (json):
    {}
}}
<div class="ng-showmore {{$modifier}}{{/modifier}}" data-ng-showmore>
    <div class="ng-showmore-body" data-ng-showmore-body>
        {{$content}}{{/content}}
    </div>
    <button type="button" class="ng-showmore-toggle" data-ng-showmore-toggle aria-expanded="false" {{!
        }}data-more="{{#str}}showmore, theme_nextgen{{/str}}" data-less="{{#str}}showless, theme_nextgen{{/str}}" hidden>
        <span class="ng-showmore-sign" aria-hidden="true">+</span>
        <span class="ng-showmore-label">{{#str}}showmore, theme_nextgen{{/str}}</span>
    </button>
</div>
