{{!
    @template theme_nextgen/blog_masthead

    Banner and breadcrumb for the public blog.

    Example context (json):
    {
        "title": "Site blog",
        "narrow": false,
        "crumbs": [{"label": "Home", "url": "https://example.com/", "home": true}],
        "empty": false,
        "emptytext": ""
    }
}}
<header class="ng-blog-mast{{#narrow}} ng-blog-mast-narrow{{/narrow}}">
    <div class="ng-blog-banner">
        <div class="ng-blog-banner-inner">
            {{#narrow}}
                <p class="ng-blog-banner-title">{{title}}</p>
            {{/narrow}}
            {{^narrow}}
                <h1 class="ng-blog-banner-title">{{title}}</h1>
            {{/narrow}}
        </div>
        <svg class="ng-blog-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path fill="rgba(255,255,255,0.14)" d="M0 36c160 36 320-28 520-8s360 40 560 8 220-36 360-8v44H0z"/>
            <path fill="rgba(255,255,255,0.22)" d="M0 52c220 22 400-16 660 4s400 18 780-12v36H0z"/>
        </svg>
    </div>
    <div class="ng-blog-mast-inner">
        <nav class="ng-blog-crumb" aria-label="{{#str}}breadcrumb, access{{/str}}">
            <ol>
                {{#crumbs}}
                    <li>
                        {{#url}}
                            <a href="{{url}}">
                                {{#home}}
                                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 4.2 3.5 11h2.2v8.2h4.6v-5.2h3.4v5.2h4.6V11h2.2z"/></svg>
                                    <span class="visually-hidden">{{label}}</span>
                                {{/home}}
                                {{^home}}{{label}}{{/home}}
                            </a>
                        {{/url}}
                        {{^url}}<span aria-current="page">{{label}}</span>{{/url}}
                    </li>
                {{/crumbs}}
            </ol>
        </nav>
        {{#empty}}<p class="ng-blog-empty">{{emptytext}}</p>{{/empty}}
    </div>
</header>
