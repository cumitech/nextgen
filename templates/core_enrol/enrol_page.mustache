{{!
    @template core_enrol/enrol_page

    NextGen presentation of an enrolment plugin widget on the checkout page.
}}
<div class="box generalbox enrol-instance ng-enrol-instance"
    data-enrol="{{enrol}}"
    data-instanceid="{{instanceid}}"
    {{#extraattributes}}{{name}}="{{value}}" {{/extraattributes}}
    {{#header}}role="region" aria-labelledby="enrol-heading-{{enrol}}-{{instanceid}}"{{/header}}
>
    {{#header}}
        <h3 id="enrol-heading-{{enrol}}-{{instanceid}}" class="ng-enrol-instance-title">{{{header}}}</h3>
    {{/header}}
    {{#body}}
        <div class="ng-enrol-instance-body">
            {{{body}}}
        </div>
    {{/body}}
    {{#hasbuttons}}
        <div class="ng-enrol-instance-actions">
            {{#buttons}}
                {{> core/single_button }}
            {{/buttons}}
        </div>
    {{/hasbuttons}}
</div>
