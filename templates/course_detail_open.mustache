{{!
    @template theme_nextgen/course_detail_open

    Opening markup for the course sales layout. The page content is inserted
    before course_detail_close.

    Example context (json):
    {
        "fullname": "Transport and logistics",
        "hasexcerpt": true,
        "excerpt": "A short summary.",
        "image": "https://example.com/course.jpg",
        "hasteacher": false,
        "hasrating": false,
        "hasprice": false,
        "hasfacts": false,
        "hassummary": false,
        "hasoutcomes": false,
        "hasrequirements": false,
        "showactivities": true,
        "enrolurl": "#ng-enrolment",
        "enrollabel": "Enrol",
        "breadcrumbs": [{"label": "Home", "url": "/"}]
    }
}}
<section class="ng-course-band" {{#image}}style="--ng-course-image: url('{{image}}')"{{/image}}>
    <div class="ng-course-band-media" aria-hidden="true"></div>
    <div class="ng-course-band-inner">
        <div class="ng-course-hero-copy">
            <nav class="ng-course-crumb" aria-label="{{#str}}breadcrumb, access{{/str}}">
                {{#breadcrumbs}}
                    {{#url}}<a href="{{url}}">{{label}}</a>{{/url}}
                    {{^url}}<span class="visually-hidden" aria-current="page">{{label}}</span>{{/url}}
                    {{^current}}<span class="ng-course-crumb-sep" aria-hidden="true">/</span>{{/current}}
                {{/breadcrumbs}}
            </nav>
            <h1 class="ng-course-title">{{fullname}}</h1>
            {{#hasexcerpt}}
                <p class="ng-course-excerpt">{{excerpt}}</p>
            {{/hasexcerpt}}
            {{#hasmeta}}
                <div class="ng-course-meta">
                    {{#bestseller}}
                        <span class="ng-bestseller">{{#str}}bestseller, theme_nextgen{{/str}}</span>
                    {{/bestseller}}
                    {{#hasrating}}
                        <div class="ng-course-stars" aria-label="{{ratinglabel}}">
                            {{#stars}}
                                <svg class="ng-star ng-star-{{state}}" viewBox="0 0 20 20" aria-hidden="true">
                                    <path class="ng-star-base" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                                    <path class="ng-star-fill" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                                </svg>
                            {{/stars}}
                            <span class="ng-course-rating-value">{{rating}}</span>
                            {{#hasreviews}}
                                <span class="ng-course-review-count">{{reviewslabel}}</span>
                            {{/hasreviews}}
                        </div>
                    {{/hasrating}}
                    {{#hasstudents}}
                        <span class="ng-course-meta-note">{{students}}</span>
                    {{/hasstudents}}
                    {{#hasupdated}}
                        <span class="ng-course-meta-note">{{updated}}</span>
                    {{/hasupdated}}
                </div>
            {{/hasmeta}}
            {{#hasteacher}}
                <div class="ng-course-teacher">
                    <a class="ng-course-teacher-link" href="{{teacher.url}}">{{{teacher.picture}}}</a>
                    <div>
                        <a class="ng-course-teacher-name" href="{{teacher.url}}">{{teacher.name}}</a>
                        <p class="ng-course-teacher-role">{{teacher.role}}</p>
                    </div>
                </div>
            {{/hasteacher}}
            <div class="ng-course-hero-actions">
                {{#hasprice}}
                    <p class="ng-course-hero-price">{{price}}</p>
                {{/hasprice}}
                <div class="ng-course-hero-cta">
                    <a class="btn btn-primary ng-course-enrol" href="{{enrolurl}}">{{enrollabel}}</a>
                    <a class="ng-course-quote ng-course-quote-hero" href="{{quoteurl}}">{{#str}}requestquote, theme_nextgen{{/str}}</a>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="ng-course-columns"{{#hasenrolsuccess}} data-ng-enrol-success="1"{{/hasenrolsuccess}}>
    {{#hasenrolsuccess}}
        <div class="ng-enrol-success" role="status">
            <div class="ng-enrol-success-copy">
                <h2>{{#str}}enrolsuccesstitle, theme_nextgen{{/str}}</h2>
                <p>{{#str}}enrolsuccesstext, theme_nextgen{{/str}}</p>
            </div>
            <a class="btn btn-primary ng-course-enrol ng-enrol-success-cta" href="{{enrolsuccessurl}}">{{#str}}enrolsuccesscta, theme_nextgen{{/str}}</a>
        </div>
    {{/hasenrolsuccess}}
    <aside class="ng-course-panel">
        {{#hasprice}}
            <p class="ng-course-price-label">{{#str}}courseprice, theme_nextgen{{/str}}</p>
            <p class="ng-course-price">{{price}}</p>
        {{/hasprice}}
        <a class="btn btn-primary ng-course-enrol" href="{{enrolurl}}">{{enrollabel}}</a>
        <a class="ng-course-quote" href="{{quoteurl}}">{{#str}}requestquote, theme_nextgen{{/str}}</a>
        {{#hasfacts}}
            <div class="ng-course-hero-card">
                <p class="ng-course-hero-card-title">{{#str}}coursedetails, theme_nextgen{{/str}}</p>
                <dl class="ng-course-hero-facts">
                    {{#facts}}
                        <div class="ng-course-hero-fact">
                            <dt>{{label}}</dt>
                            <dd{{#hastone}} class="is-{{tone}}"{{/hastone}}>{{value}}</dd>
                        </div>
                    {{/facts}}
                </dl>
            </div>
        {{/hasfacts}}
        <div class="ng-course-share">
            <h2>{{#str}}sharecourse, theme_nextgen{{/str}}</h2>
            <button type="button" class="ng-copy-link" data-ng-copy="{{shareurl}}" data-ng-copied="{{#str}}linkcopied, theme_nextgen{{/str}}" data-ng-copy-label="{{#str}}copylink, theme_nextgen{{/str}}">
                <span class="ng-copy-label">{{#str}}copylink, theme_nextgen{{/str}}</span>
            </button>
        </div>
    </aside>
    <div class="ng-course-primary">
    <div class="ng-course-tabs" role="tablist" aria-label="{{fullname}}">
        <button type="button" class="is-active" role="tab" id="ng-tab-overview" data-ng-tab="overview" aria-selected="true" aria-controls="ng-panel-overview">{{#str}}taboverview, theme_nextgen{{/str}}</button>
        <button type="button" role="tab" id="ng-tab-content" data-ng-tab="content" aria-selected="false" aria-controls="ng-course-content">{{#str}}coursecontent, theme_nextgen{{/str}}</button>
        <button type="button" role="tab" id="ng-tab-certificate" data-ng-tab="certificate" aria-selected="false" aria-controls="ng-panel-certificate">{{#str}}tabcertificate, theme_nextgen{{/str}}</button>
        <button type="button" role="tab" id="ng-tab-instructors" data-ng-tab="instructors" aria-selected="false" aria-controls="ng-panel-instructors">{{#str}}tabinstructors, theme_nextgen{{/str}}</button>
        <button type="button" role="tab" id="ng-tab-reviews" data-ng-tab="reviews" aria-selected="false" aria-controls="ng-panel-reviews">
            {{#str}}tabreviews, theme_nextgen{{/str}}
            {{#hasrating}}
                <span class="ng-tab-stars" aria-hidden="true">
                    {{#stars}}
                        <svg class="ng-star ng-star-{{state}}" viewBox="0 0 20 20">
                            <path class="ng-star-base" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                            <path class="ng-star-fill" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                        </svg>
                    {{/stars}}
                </span>
            {{/hasrating}}
        </button>
    </div>
    <div class="ng-course-main" id="ng-panel-overview" data-ng-panel="overview" role="tabpanel" aria-labelledby="ng-tab-overview">
        {{#hassummary}}
            <section class="ng-course-section">
                <h2>{{#str}}courseabout, theme_nextgen{{/str}}</h2>
                {{< theme_nextgen/showmore }}
                    {{$content}}<div class="ng-course-summary">{{{summary}}}</div>{{/content}}
                {{/ theme_nextgen/showmore }}
            </section>
        {{/hassummary}}
        {{#hasoutcomes}}
            <section class="ng-course-section ng-course-card">
                <h2>{{outcometitle}}</h2>
                {{#hasoutcomelead}}
                    <p class="ng-outcome-lead">{{outcomelead}}</p>
                {{/hasoutcomelead}}
                {{< theme_nextgen/showmore }}
                    {{$modifier}}ng-showmore-lg{{/modifier}}
                    {{$content}}
                        <ul class="ng-outcomes">
                            {{#outcomes}}
                                <li><span class="ng-tick" aria-hidden="true"></span><span>{{text}}</span></li>
                            {{/outcomes}}
                        </ul>
                    {{/content}}
                {{/ theme_nextgen/showmore }}
            </section>
        {{/hasoutcomes}}
        {{#hasrequirements}}
            <section class="ng-course-section">
                <h2>{{#str}}courserequirements, theme_nextgen{{/str}}</h2>
                <ol class="ng-requirements">
                    {{#requirements}}
                        <li>{{text}}</li>
                    {{/requirements}}
                </ol>
            </section>
        {{/hasrequirements}}
    </div>
    <div class="ng-course-main ng-course-panelpage" id="ng-panel-certificate" data-ng-panel="certificate" role="tabpanel" aria-labelledby="ng-tab-certificate" hidden>
        <section class="ng-course-section ng-course-card">
            <h2>{{#str}}tabcertificate, theme_nextgen{{/str}}</h2>
            {{#hascertificate}}
                <div class="ng-certificate-facts">
                    <p>{{#str}}certificatelead, theme_nextgen{{/str}}</p>
                    <ul>
                        <li>{{#str}}certificatefactname, theme_nextgen{{/str}}</li>
                        <li>{{#str}}certificatefactfee, theme_nextgen{{/str}}</li>
                        <li>{{#str}}certificatefactsample, theme_nextgen{{/str}}</li>
                    </ul>
                </div>
                <figure class="ng-certificate">
                    <figcaption class="ng-certificate-sample">{{#str}}certificatesample, theme_nextgen{{/str}}</figcaption>
                    <div class="ng-certificate-sheet">
                        <div class="ng-certificate-frame" data-sample="{{#str}}certificatesamplemark, theme_nextgen{{/str}}">
                            <div class="ng-certificate-seal" aria-hidden="true">
                                <svg viewBox="0 0 64 64" width="38" height="38">
                                    <circle cx="32" cy="32" r="22" fill="none" stroke="#FCD116" stroke-width="1.5"></circle>
                                    <path d="M22 33.5l6.2 6.2L42 25" fill="none" stroke="#FCD116" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                            </div>
                            <p class="ng-certificate-kicker">{{#str}}certificatesubtitle, theme_nextgen{{/str}}</p>
                            <p class="ng-certificate-issuer">{{sitename}}</p>
                            <p class="ng-certificate-title">{{#str}}certificatetitle, theme_nextgen{{/str}}</p>
                            <div class="ng-certificate-rule" aria-hidden="true"></div>
                            <p class="ng-certificate-lead">{{#str}}certificatecertifies, theme_nextgen{{/str}}</p>
                            <p class="ng-certificate-name">{{#str}}certificatelearner, theme_nextgen{{/str}}</p>
                            <p class="ng-certificate-completed">{{#str}}certificatecompleted, theme_nextgen{{/str}}</p>
                            <p class="ng-certificate-course">{{fullname}}</p>
                            <div class="ng-certificate-signs">
                                <div class="ng-certificate-sign">
                                    <span class="ng-certificate-sign-value">{{#str}}certificatesampledate, theme_nextgen{{/str}}</span>
                                    <span class="ng-certificate-sign-label">{{#str}}certificatedatelabel, theme_nextgen{{/str}}</span>
                                </div>
                                <div class="ng-certificate-sign">
                                    <span class="ng-certificate-sign-value">{{#hasteacher}}{{teacher.name}}{{/hasteacher}}{{^hasteacher}}{{#str}}certificateinstructorname, theme_nextgen{{/str}}{{/hasteacher}}</span>
                                    <span class="ng-certificate-sign-label">{{#str}}certificateinstructorlabel, theme_nextgen{{/str}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </figure>
                <p class="ng-certificate-note">{{#str}}certificatesamplenote, theme_nextgen{{/str}}</p>
                {{#certificatenote}}
                    <p class="ng-certificate-note">{{certificatenote}}</p>
                {{/certificatenote}}
                {{#certificates}}
                    <p class="ng-certificate-activity">{{#url}}<a href="{{url}}">{{name}}</a>{{/url}}{{^url}}{{name}}{{/url}}</p>
                {{/certificates}}
            {{/hascertificate}}
            {{^hascertificate}}
                <div class="ng-certificate-none">
                    <span class="ng-certificate-none-mark" aria-hidden="true"></span>
                    <div>
                        <p class="ng-certificate-none-title">{{#str}}certificateempty, theme_nextgen{{/str}}</p>
                        <ul class="ng-certificate-facts">
                            <li>{{#str}}certificatenone, theme_nextgen{{/str}}</li>
                            <li>{{#str}}certificatenonefinish, theme_nextgen{{/str}}</li>
                            <li>{{#str}}certificatenonefee, theme_nextgen{{/str}}</li>
                        </ul>
                    </div>
                </div>
            {{/hascertificate}}
        </section>
    </div>
    <div class="ng-course-main ng-course-panelpage" id="ng-panel-instructors" data-ng-panel="instructors" role="tabpanel" aria-labelledby="ng-tab-instructors" hidden>
        <section class="ng-course-section">
            <h2>{{#str}}tabinstructors, theme_nextgen{{/str}}</h2>
            {{#hasinstructors}}
                <ul class="ng-instructor-list">
                    {{#instructors}}
                        <li class="ng-instructor-card">
                            <div class="ng-instructor-side">
                                <a href="{{url}}">{{{picture}}}</a>
                                <ul class="ng-instructor-stats">
                                    <li><span>{{courseslabel}}</span></li>
                                    {{#hasstudents}}
                                        <li><span>{{studentslabel}}</span></li>
                                    {{/hasstudents}}
                                </ul>
                            </div>
                            <div class="ng-instructor-body">
                                <a class="ng-instructor-name" href="{{url}}">{{name}}</a>
                                <p class="ng-instructor-credential">{{credential}}</p>
                                {{#hasbio}}
                                    {{< theme_nextgen/showmore }}
                                        {{$content}}<div class="ng-instructor-bio">{{{bio}}}</div>{{/content}}
                                    {{/ theme_nextgen/showmore }}
                                {{/hasbio}}
                            </div>
                        </li>
                    {{/instructors}}
                </ul>
            {{/hasinstructors}}
            {{^hasinstructors}}
                <p class="ng-course-empty">{{#str}}courseinstructorsempty, theme_nextgen{{/str}}</p>
            {{/hasinstructors}}
        </section>
    </div>
    <div class="ng-course-main ng-course-panelpage" id="ng-panel-reviews" data-ng-panel="reviews" role="tabpanel" aria-labelledby="ng-tab-reviews" hidden>
        <section class="ng-course-section">
            {{#hasrating}}
                <h2>{{#str}}courserating, theme_nextgen{{/str}}</h2>
                <div class="ng-rating-layout">
                    <div class="ng-rating-scoreblock">
                        <p class="ng-review-score">{{rating}}</p>
                        <div>
                            <div class="ng-course-stars" aria-label="{{ratinglabel}}">
                                {{#stars}}
                                    <svg class="ng-star ng-star-{{state}}" viewBox="0 0 20 20" aria-hidden="true">
                                        <path class="ng-star-base" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                                        <path class="ng-star-fill" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                                    </svg>
                                {{/stars}}
                            </div>
                            {{#hasreviews}}
                                <p class="ng-rating-count">{{ratingslabel}}</p>
                            {{/hasreviews}}
                        </div>
                    </div>
                    {{#hasdistribution}}
                        <ul class="ng-rating-bars">
                            {{#distribution}}
                                <li>
                                    <span class="ng-rating-level">{{level}} <svg class="ng-star" viewBox="0 0 20 20" aria-hidden="true"><path class="ng-star-fill" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path></svg></span>
                                    <span class="ng-rating-track"><span class="ng-rating-fill" style="--ng-bar: {{percent}}%"></span></span>
                                    <span class="ng-rating-percent">{{percent}}%</span>
                                </li>
                            {{/distribution}}
                        </ul>
                    {{/hasdistribution}}
                </div>
            {{/hasrating}}
            <h2>{{#str}}tabreviews, theme_nextgen{{/str}}</h2>
            {{#canreview}}
                {{> theme_nextgen/course_review_form}}
            {{/canreview}}
            {{#reviewlogin}}
                <p class="ng-review-login">
                    <a class="btn btn-primary" href="{{reviewloginurl}}">{{#str}}reviewlogin, theme_nextgen{{/str}}</a>
                </p>
            {{/reviewlogin}}
            {{#hasreviewlist}}
                <ul class="ng-review-list">
                    {{#reviewlist}}
                        <li class="ng-review-item">
                            <span class="ng-review-avatar" aria-hidden="true">{{#avatar}}{{{avatar}}}{{/avatar}}{{^avatar}}{{initials}}{{/avatar}}</span>
                            <div>
                                <div class="ng-review-meta">
                                    <span class="ng-course-stars" aria-hidden="true">
                                        {{#stars}}
                                            <svg class="ng-star ng-star-{{state}}" viewBox="0 0 20 20">
                                                <path class="ng-star-base" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                                                <path class="ng-star-fill" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"></path>
                                            </svg>
                                        {{/stars}}
                                    </span>
                                    <strong>{{name}}</strong>
                                    {{#date}}<span class="ng-review-date">{{date}}</span>{{/date}}
                                </div>
                                {{< theme_nextgen/showmore }}
                                    {{$modifier}}ng-showmore-sm{{/modifier}}
                                    {{$content}}<p>{{text}}</p>{{/content}}
                                {{/ theme_nextgen/showmore }}
                            </div>
                        </li>
                    {{/reviewlist}}
                </ul>
            {{/hasreviewlist}}
            {{^hasreviewlist}}
                <p class="ng-course-empty">{{#str}}reviewempty, theme_nextgen{{/str}}</p>
            {{/hasreviewlist}}
        </section>
    </div>
    <div class="ng-course-below" id="ng-course-content" data-ng-panel="content" role="tabpanel" aria-labelledby="ng-tab-content" hidden>
        {{#hasoutline}}
            <div class="ng-outline">
                <div class="ng-outline-head">
                    <div>
                        <h2>{{#str}}coursecontent, theme_nextgen{{/str}}</h2>
                        <p class="ng-outline-meta">{{outlinecounts}}</p>
                    </div>
                    <button type="button" class="ng-outline-expand" data-ng-expand data-expand-label="{{#str}}expandall, theme_nextgen{{/str}}" data-collapse-label="{{#str}}collapseall, theme_nextgen{{/str}}">{{#str}}expandall, theme_nextgen{{/str}}</button>
                </div>
                <label class="ng-outline-search">
                    <span class="visually-hidden">{{#str}}contentsearch, theme_nextgen{{/str}}</span>
                    <input type="search" data-ng-outline-search placeholder="{{#str}}contentsearch, theme_nextgen{{/str}}">
                </label>
                {{#sections}}
                    <details class="ng-outline-section" data-ng-outline-name="{{name}}" {{#open}}open{{/open}}>
                        <summary>
                            <span class="ng-outline-num">{{number}}</span>
                            <span class="ng-outline-title">{{name}}</span>
                        </summary>
                        {{#hasactivities}}
                            <ul class="ng-outline-list">
                                {{#activities}}
                                    <li class="ng-outline-item" data-ng-outline-text="{{name}}">
                                        {{#url}}<a href="{{url}}">{{/url}}
                                        {{#iconurl}}<img class="ng-outline-modicon" src="{{iconurl}}" alt="">{{/iconurl}}
                                        <span>{{name}}</span>
                                        {{#locked}}<span class="ng-outline-lock" aria-label="{{#str}}locked, core{{/str}}">{{#pix}}i/locked, core{{/pix}}</span>{{/locked}}
                                        {{#url}}</a>{{/url}}
                                        {{^url}}<span class="ng-outline-lock" aria-label="{{#str}}locked, core{{/str}}">{{#pix}}i/locked, core{{/pix}}</span>{{/url}}
                                    </li>
                                {{/activities}}
                            </ul>
                        {{/hasactivities}}
                    </details>
                {{/sections}}
            </div>
        {{/hasoutline}}
        {{#outlineempty}}
            <p class="ng-course-empty">{{#str}}contentempty, theme_nextgen{{/str}}</p>
        {{/outlineempty}}
