{{!
    @template theme_nextgen/course_card

    Course card for marketing pages. My courses uses core_course/coursecard.
}}
<article class="ng-course-card">
    <a class="ng-course-media" href="{{url}}">
        <img src="{{image}}" alt="{{fullname}}">
        {{#bestseller}}
            <span class="ng-course-badge">{{#str}}bestseller, theme_nextgen{{/str}}</span>
        {{/bestseller}}
    </a>
    <div class="ng-course-body">
        <h3 class="ng-course-title"><a href="{{url}}">{{fullname}}</a></h3>
        {{#hasexcerpt}}
            <p class="ng-course-blurb">{{excerpt}}</p>
        {{/hasexcerpt}}
        {{#hasteachers}}
            <p class="ng-course-teachers">{{teachers}}</p>
        {{/hasteachers}}
        {{#hasrating}}
            <p class="ng-course-rating">
                <span class="visually-hidden">{{ratinglabel}}</span>
                <span class="ng-course-rating-value" aria-hidden="true">{{rating}}</span>
                <span class="ng-course-stars" aria-hidden="true">
                    {{#stars}}
                        <svg class="ng-star ng-star-{{state}}" viewBox="0 0 20 20">
                            <path class="ng-star-base" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"/>
                            <path class="ng-star-fill" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"/>
                        </svg>
                    {{/stars}}
                </span>
                {{#hasreviews}}
                    <span class="ng-course-reviews" aria-hidden="true">{{reviewslabel}}</span>
                {{/hasreviews}}
            </p>
        {{/hasrating}}
        <p class="ng-course-commerce">
            {{#hasprice}}
                <span class="ng-course-price">{{price}}</span>
            {{/hasprice}}
            <span class="ng-course-stats">
                <span class="ng-course-enrols">{{#str}}studentcount, theme_nextgen, {{enrolments}}{{/str}}</span>
                <span class="ng-course-date">{{date}}</span>
            </span>
        </p>
    </div>
    <div class="ng-course-action">
        <a class="btn btn-primary" href="{{actionurl}}">{{actionlabel}}</a>
    </div>
</article>
