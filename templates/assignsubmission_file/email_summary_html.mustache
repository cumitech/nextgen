{{!
    @template assignsubmission_file/email_summary_html

    File summary inside an assignment receipt.
}}
<p style="color:#163A4A;font-size:16px;font-weight:700;margin:16px 0 4px;">{{#str}}file, assignsubmission_file{{/str}}</p>
<ul style="margin:0;padding-left:18px;">
{{#files}}
    <li style="margin:0 0 4px;">{{#str}}filewithsize, assignsubmission_file, {"filename": {{#quote}}{{filepath}}{{/quote}}, "size": {{#quote}}{{filesize}}{{/quote}}, "coursename": {{#quote}}{{coursename}}{{/quote}} } {{/str}}</li>
{{/files}}
</ul>
