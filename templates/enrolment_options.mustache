{{!
    @template theme_nextgen/enrolment_options

    Enrolment forms for the course page. Widget markup comes from the enrol plugins.

    Example context (json):
    {
        "widgets": ["<div>Self enrolment</div>"],
        "message": "",
        "continuebutton": ""
    }
}}
<div id="ng-enrolment" class="ng-enrol-stack">
    <h2>{{#str}}enrolmentoptions, enrol{{/str}}</h2>
    {{#widgets}}
        <div class="ng-enrol-card">{{{.}}}</div>
    {{/widgets}}
    {{^widgets}}
        <div class="ng-enrol-card">
            <p>{{message}}</p>
            {{{continuebutton}}}
        </div>
    {{/widgets}}
</div>
