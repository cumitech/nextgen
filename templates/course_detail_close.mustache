require(['jquery'], function($) {
    var root = document.querySelector('.ng-course-columns');
    if (!root) {
        return;
    }
    var tabs = root.querySelectorAll('[data-ng-tab]');
    var panels = root.querySelectorAll('[data-ng-panel]');

    var show = function(name) {
        tabs.forEach(function(tab) {
            var on = tab.getAttribute('data-ng-tab') === name;
            tab.classList.toggle('is-active', on);
            tab.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function(panel) {
            if (panel.getAttribute('data-ng-panel') === name) {
                panel.hidden = false;
            } else {
                panel.hidden = true;
            }
        });
        window.dispatchEvent(new Event('resize'));
    };

    tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
            show(tab.getAttribute('data-ng-tab'));
        });
    });

    var fromHash = function() {
        var hash = window.location.hash;
        if (hash === '#ng-course-content' || hash === '#ng-enrolment') {
            return 'content';
        }
        if (hash === '#ng-panel-instructors') {
            return 'instructors';
        }
        if (hash === '#ng-panel-reviews') {
            return 'reviews';
        }
        if (hash === '#ng-panel-certificate') {
            return 'certificate';
        }
        return 'overview';
    };

    document.querySelectorAll('.ng-course-enrol').forEach(function(link) {
        link.addEventListener('click', function(event) {
            var href = link.getAttribute('href') || '';
            if (href.indexOf('#ng-course-content') === -1 && href.indexOf('#ng-enrolment') === -1) {
                return;
            }
            event.preventDefault();
            show('content');
            var target = document.getElementById(href.slice(href.indexOf('#') + 1));
            if (target) {
                target.scrollIntoView({behavior: 'smooth', block: 'start'});
            }
        });
    });

    if (root.getAttribute('data-ng-enrol-success') === '1') {
        show('content');
    } else {
        show(fromHash());
    }

    var expand = root.querySelector('[data-ng-expand]');
    if (expand) {
        expand.addEventListener('click', function() {
            var opening = expand.getAttribute('data-ng-expanded') !== '1';
            root.querySelectorAll('.ng-outline-section').forEach(function(section) {
                section.open = opening;
            });
            expand.setAttribute('data-ng-expanded', opening ? '1' : '0');
            expand.textContent = opening ? expand.getAttribute('data-collapse-label') : expand.getAttribute('data-expand-label');
        });
    }

    var search = root.querySelector('[data-ng-outline-search]');
    if (search) {
        search.addEventListener('input', function() {
            var query = search.value.trim().toLowerCase();
            root.querySelectorAll('.ng-outline-section').forEach(function(section) {
                var sectionname = (section.getAttribute('data-ng-outline-name') || '').toLowerCase();
                var named = query !== '' && sectionname.indexOf(query) !== -1;
                var any = false;
                section.querySelectorAll('.ng-outline-item').forEach(function(item) {
                    var text = (item.getAttribute('data-ng-outline-text') || '').toLowerCase();
                    var match = query === '' || named || text.indexOf(query) !== -1;
                    item.hidden = !match;
                    if (match) {
                        any = true;
                    }
                });
                section.hidden = query !== '' && !any && !named;
                if (query !== '' && (any || named)) {
                    section.open = true;
                }
            });
        });
    }

    document.querySelectorAll('[data-ng-copy]').forEach(function(copy) {
        copy.addEventListener('click', function() {
            var url = copy.getAttribute('data-ng-copy') || '';
            var label = copy.getAttribute('data-ng-copy-label') || '';
            var copied = copy.getAttribute('data-ng-copied') || label;
            var text = copy.querySelector('.ng-copy-label');
            var mark = function() {
                if (text) {
                    text.textContent = copied;
                } else {
                    copy.textContent = copied;
                }
                window.setTimeout(function() {
                    if (text) {
                        text.textContent = label;
                    } else {
                        copy.textContent = label;
                    }
                }, 1600);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(url).then(mark);
            }
        });
    });
});
{{/js}}
