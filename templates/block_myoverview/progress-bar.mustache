{{!
    @template block_myoverview/progress-bar

    Percentage label and a bar for one course card.
}}
<div class="ng-dash-progress">
    <div class="progress-text">
        <span class="visually-hidden">{{#str}}aria:courseprogress, block_myoverview{{/str}}</span>
        {{#str}}completepercent, block_myoverview, <span>{{progress}}</span>{{/str}}
    </div>
    <div class="ng-dash-progress-track" role="progressbar" aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100">
        <span style="width: {{progress}}%"></span>
    </div>
</div>
