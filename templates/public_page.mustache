{{!
    @template theme_nextgen/public_page

    Public information page: about, team, contact, privacy, terms, or FAQ.
}}
{{#iscontact}}
<article class="ng-public ng-contact">
    <header class="ng-public-hero ng-contact-hero">
        <div class="ng-landing-inner ng-contact-wrap">
            {{{navbar}}}
            <h1 class="ng-public-title">{{title}}</h1>
            <p class="ng-public-intro">{{intro}}</p>
        </div>
    </header>
    <div class="ng-landing-inner ng-contact-wrap ng-public-body ng-contact-body">
        <div class="ng-contact-layout">
            <aside class="ng-contact-aside">
                <section class="ng-contact-panel ng-contact-channels">
                    <h2>{{channelstitle}}</h2>
                    {{#haschannels}}
                        <dl class="ng-contact-channel-list">
                            {{#hasphone}}
                                <div>
                                    <dt>{{#str}}contactphonelabel, theme_nextgen{{/str}}</dt>
                                    <dd>
                                        {{#phoneurl}}<a href="{{phoneurl}}">{{phone}}</a>{{/phoneurl}}
                                        {{^phoneurl}}{{phone}}{{/phoneurl}}
                                    </dd>
                                </div>
                            {{/hasphone}}
                            {{#hasemail}}
                                <div>
                                    <dt>{{#str}}contactemaillabel, theme_nextgen{{/str}}</dt>
                                    <dd><a href="{{emailurl}}">{{email}}</a></dd>
                                </div>
                            {{/hasemail}}
                            {{#offices}}
                                <div>
                                    <dt>{{#label}}{{label}}{{/label}}{{^label}}{{#str}}officelabel, theme_nextgen{{/str}}{{/label}}</dt>
                                    <dd>
                                        {{address}}
                                        <a href="{{mapurl}}" target="_blank" rel="noopener noreferrer">{{#str}}officedirections, theme_nextgen{{/str}}</a>
                                    </dd>
                                </div>
                            {{/offices}}
                        </dl>
                    {{/haschannels}}
                    <p class="ng-contact-response">{{response}}</p>
                </section>
                {{#socialblock}}
                    <section class="ng-contact-panel ng-contact-social">
                        <h2>{{#str}}socialfollowtitle, theme_nextgen{{/str}}</h2>
                        <p>{{#str}}socialfollowlead, theme_nextgen{{/str}}</p>
                        {{> theme_nextgen/social_links }}
                    </section>
                {{/socialblock}}
            </aside>
            <section class="ng-contact-panel ng-contact-formcard">
                <h2>{{formtitle}}</h2>
                <p class="ng-contact-formlead">{{formlead}}</p>
                {{#hasform}}
                    <div class="ng-public-form ng-contact-form">{{{form}}}</div>
                {{/hasform}}
            </section>
        </div>
    </div>
    {{#partnersblock}}
        {{> theme_nextgen/partners }}
    {{/partnersblock}}
</article>
{{/iscontact}}
{{#isabout}}
    {{> theme_nextgen/about_page }}
{{/isabout}}
{{#isteam}}
    {{> theme_nextgen/team_page }}
{{/isteam}}
{{#isdefault}}
<article class="ng-public">
    <header class="ng-public-hero">
        <div class="ng-landing-inner ng-public-wrap">
            {{{navbar}}}
            <h1 class="ng-public-title">{{title}}</h1>
            <p class="ng-public-intro">{{intro}}</p>
        </div>
    </header>
    <div class="ng-landing-inner ng-public-wrap ng-public-body">
        <div class="ng-public-card">
            {{#sections}}
                <section class="ng-public-section">
                    <h2>{{title}}</h2>
                    <p>{{text}}</p>
                    {{#url}}
                        <p class="ng-public-action"><a class="btn btn-primary" href="{{url}}">{{urllabel}}</a></p>
                    {{/url}}
                </section>
            {{/sections}}
            {{#hasquestions}}
                <div class="ng-public-faqs">
                    {{#questions}}
                        <details class="ng-public-faq">
                            <summary>{{question}}</summary>
                            <p>{{answer}}</p>
                        </details>
                    {{/questions}}
                </div>
            {{/hasquestions}}
            {{#hasform}}
                <div class="ng-public-form">{{{form}}}</div>
            {{/hasform}}
        </div>
    </div>
</article>
{{/isdefault}}
