{{!
    @template core_payment/gateway

    Theme override of the Moodle gateway card. Campay's method selector is
    hidden for other gateways by the theme stylesheet.
}}
<div class="form-check {{shortname}}">
    <input class="form-check-input" type="radio" name="payby" id="id-payby-{{uniqid}}-{{shortname}}"
        data-cost="{{cost}}" data-surcharge="{{surcharge}}" value="{{shortname}}" {{#checked}} checked="checked" {{/checked}} />
    <h3 class="h3 ng-campay-method-heading">{{#str}} campaymethodheading, theme_nextgen {{/str}}</h3>
    <label class="form-check-label bg-light border p-3 my-3" for="id-payby-{{uniqid}}-{{shortname}}">
        <p class="h3 ng-payment-gateway-name">{{name}}</p>
        <p class="content mb-2">{{{description}}}</p>
        {{#pix}} img, paygw_{{shortname}} {{/pix}}
    </label>
    {{> theme_nextgen/campay_payment_methods }}
</div>
