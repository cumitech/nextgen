{{!
    @template theme_nextgen/landing

    Site home marketing page. Course and category data is supplied by the theme.
}}
<div class="ng-landing">
    <section class="ng-hero">
        <div class="ng-hero-slides" aria-hidden="true">
            <span class="ng-hero-slide"></span>
            <span class="ng-hero-slide"></span>
            <span class="ng-hero-slide"></span>
            <span class="ng-hero-slide"></span>
        </div>
        <div class="ng-landing-inner ng-hero-grid">
            <div>
                <h1 class="ng-hero-title">{{herotitle}}</h1>
                <p class="ng-hero-text">{{herotext}}</p>
                <div class="ng-hero-actions">
                    {{#hasprimary}}
                        <a class="btn btn-primary btn-lg" href="{{primary.url}}">{{primary.label}}</a>
                    {{/hasprimary}}
                    {{#hassecondary}}
                        <a class="btn btn-lg ng-btn-ghost" href="{{secondary.url}}">{{secondary.label}}</a>
                    {{/hassecondary}}
                </div>
            </div>
        </div>
    </section>

    <section class="ng-section ng-tiles" id="why-nextgen">
        <div class="ng-landing-inner">
            <div class="ng-tile-grid">
                {{#reasons}}
                    <article class="ng-tile ng-tile-{{tone}}">
                        <span class="ng-tile-pattern" aria-hidden="true"></span>
                        <h2>{{title}}</h2>
                    </article>
                {{/reasons}}
            </div>
        </div>
    </section>

    <section class="ng-section ng-forward">
        <div class="ng-landing-inner ng-forward-grid">
            <div>
                <h2>{{#str}}whyheading, theme_nextgen{{/str}}</h2>
                <p class="ng-forward-text">{{forwardtext}}</p>
                <a class="btn btn-primary" href="{{coursesurl}}">{{#str}}browseall, theme_nextgen{{/str}}</a>
            </div>
            <ol class="ng-forward-list">
                {{#steps}}
                    <li>
                        <span class="ng-step-number">{{number}}</span>
                        <div>
                            <h3>{{title}}</h3>
                            <p>{{text}}</p>
                        </div>
                    </li>
                {{/steps}}
            </ol>
        </div>
    </section>

    <section class="ng-section ng-section-muted" id="featured-courses">
        <div class="ng-landing-inner">
            <div class="ng-section-head">
                <h2>{{#str}}featuredheading, theme_nextgen{{/str}}</h2>
                <a href="{{coursesurl}}">{{#str}}browseall, theme_nextgen{{/str}}</a>
            </div>
            {{#hascourses}}
                <div class="ng-card-grid">
                    {{#courses}}
                        {{> theme_nextgen/course_card }}
                    {{/courses}}
                </div>
            {{/hascourses}}
            {{^hascourses}}
                <p class="ng-empty">{{#str}}nocoursesyet, theme_nextgen{{/str}}</p>
            {{/hascourses}}
        </div>
    </section>

    {{#hascategories}}
        <section class="ng-section ng-category-section" id="categories">
            <div class="ng-landing-inner">
                <h2>{{#str}}categoriesheading, theme_nextgen{{/str}}</h2>
                <div class="ng-category-grid">
                    {{#categories}}
                        <a class="ng-category-tile" href="{{url}}">
                            <img class="ng-category-photo" src="{{image}}" alt="">
                            <span class="ng-category-copy">
                                <span class="ng-category-name">{{name}}</span>
                                <span class="ng-category-count">{{countlabel}}</span>
                            </span>
                        </a>
                    {{/categories}}
                </div>
            </div>
        </section>
    {{/hascategories}}

    {{#partnersblock}}
        {{> theme_nextgen/partners }}
    {{/partnersblock}}

    <section class="ng-section ng-stats">
        <div class="ng-landing-inner">
            <ul class="ng-stats-list" aria-label="{{#str}}platformstats, theme_nextgen{{/str}}">
                {{#stats}}
                    <li class="ng-stat">
                        <strong>{{value}}</strong>
                        <span>{{label}}</span>
                    </li>
                {{/stats}}
            </ul>
        </div>
    </section>

    {{#hasinstructors}}
        <section class="ng-section ng-faculty" id="instructors" data-ng-faculty>
            <div class="ng-landing-inner">
                <div class="ng-faculty-grid">
                    <div class="ng-faculty-stage">
                        <span class="ng-faculty-shape ng-faculty-shape-gold" aria-hidden="true"></span>
                        <span class="ng-faculty-shape ng-faculty-shape-green" aria-hidden="true"></span>
                        <span class="ng-faculty-shape ng-faculty-shape-clay" aria-hidden="true"></span>
                        <div class="ng-faculty-ring">
                            {{#instructors}}
                                <a class="ng-faculty-slide{{#active}} is-active{{/active}}" href="{{url}}">
                                    {{{picture}}}
                                    <span class="visually-hidden">{{name}}</span>
                                </a>
                            {{/instructors}}
                        </div>
                        {{#hasslider}}
                            <div class="ng-faculty-controls">
                                <button type="button" class="ng-faculty-control" data-ng-faculty-prev aria-label="{{#str}}facultyprev, theme_nextgen{{/str}}">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                                <button type="button" class="ng-faculty-control" data-ng-faculty-next aria-label="{{#str}}facultynext, theme_nextgen{{/str}}">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6.5L15 12l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>
                        {{/hasslider}}
                    </div>
                    <div class="ng-faculty-copy">
                        <h2>{{#str}}instructorsheading, theme_nextgen{{/str}}</h2>
                        <p>{{#str}}instructorintro, theme_nextgen{{/str}}</p>
                        <ul class="ng-faculty-points">
                            {{#facultypoints}}
                                <li><span class="ng-faculty-check" aria-hidden="true"></span>{{title}}</li>
                            {{/facultypoints}}
                        </ul>
                        <div class="ng-faculty-names">
                            {{#instructors}}
                                <p class="ng-faculty-name{{#active}} is-active{{/active}}">
                                    <a href="{{url}}"><strong>{{name}}</strong><span>{{role}}</span></a>
                                </p>
                            {{/instructors}}
                        </div>
                    </div>
                </div>
            </div>
        </section>
    {{/hasinstructors}}

    {{#hasquotes}}
        <section class="ng-section" id="learner-reviews">
            <div class="ng-landing-inner">
                <div class="ng-section-head">
                    <h2>{{#str}}quotesheading, theme_nextgen{{/str}}</h2>
                </div>
                <div class="ng-quote-grid">
                    {{#quotes}}
                        <blockquote class="ng-quote">
                            <p class="ng-course-stars" aria-hidden="true">
                                {{#stars}}
                                    <svg class="ng-star ng-star-{{state}}" viewBox="0 0 20 20">
                                        <path class="ng-star-base" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"/>
                                        <path class="ng-star-fill" d="M10 1.6l2.2 4.7 5.1.6-3.8 3.5.9 5.1L10 13.2 5.6 15.5l.9-5.1L2.7 6.9l5.1-.6L10 1.6z"/>
                                    </svg>
                                {{/stars}}
                            </p>
                            <p class="ng-quote-text">{{text}}</p>
                            <footer>
                                <span class="ng-quote-person">
                                    <span class="ng-quote-avatar" aria-hidden="true">{{{avatar}}}</span>
                                    <span>
                                        <cite>{{name}}</cite>
                                        <a href="{{courseurl}}">{{course}}</a>
                                    </span>
                                </span>
                            </footer>
                        </blockquote>
                    {{/quotes}}
                </div>
            </div>
        </section>
    {{/hasquotes}}

    <section class="ng-section ng-section-muted ng-institutions" id="institutional-programmes">
        <div class="ng-landing-inner">
            <div class="ng-institutions-layout">
                <div class="ng-institutions-copy">
                    <h2>{{#str}}institutionheading, theme_nextgen{{/str}}</h2>
                    <p>{{#str}}institutionintro, theme_nextgen{{/str}}</p>
                    <a class="btn btn-primary" href="{{contacturl}}">{{#str}}institutioncta, theme_nextgen{{/str}}</a>
                </div>
                <div class="ng-institution-list">
                    {{#offers}}
                        <article>
                            <span class="ng-institution-icon" aria-hidden="true">
                                {{#packages}}
                                    <svg viewBox="0 0 24 24"><path d="M12 3.5l8 3.8-8 3.8-8-3.8 8-3.8z"/><path d="M4 12.2l8 3.8 8-3.8"/><path d="M4 16.6l8 3.8 8-3.8"/></svg>
                                {{/packages}}
                                {{#cohorts}}
                                    <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="2.6"/><circle cx="16" cy="9" r="2"/><path d="M3.8 18.5c.5-2.5 2.6-4 5.2-4s4.7 1.5 5.2 4"/><path d="M14.2 14.8c1.5-.4 3 .1 4 1.4.5.7.9 1.5 1.1 2.3"/></svg>
                                {{/cohorts}}
                                {{#custom}}
                                    <svg viewBox="0 0 24 24"><path d="M4 7h9"/><path d="M17 7h3"/><circle cx="15" cy="7" r="1.7"/><path d="M4 12h3"/><path d="M11 12h9"/><circle cx="9" cy="12" r="1.7"/><path d="M4 17h7"/><path d="M15 17h5"/><circle cx="13" cy="17" r="1.7"/></svg>
                                {{/custom}}
                            </span>
                            <div>
                                <h3>{{title}}</h3>
                                <p>{{text}}</p>
                            </div>
                        </article>
                    {{/offers}}
                </div>
            </div>
        </div>
    </section>

    <section class="ng-cta">
        <div class="ng-landing-inner">
            <div class="ng-cta-banner">
                <img class="ng-cta-photo" src="{{ctaimage}}" alt="" aria-hidden="true">
                <div class="ng-cta-copy">
                    <h2>{{#str}}ctaheading, theme_nextgen{{/str}}</h2>
                    <p>{{#str}}ctatext, theme_nextgen{{/str}}</p>
                    <a class="ng-cta-link" href="{{#isloggedin}}{{coursesurl}}{{/isloggedin}}{{^isloggedin}}{{loginurl}}{{/isloggedin}}">
                        {{#isloggedin}}{{#str}}browseall, theme_nextgen{{/str}}{{/isloggedin}}
                        {{^isloggedin}}{{#str}}ctaguest, theme_nextgen{{/str}}{{/isloggedin}}
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
