{{!
    @template theme_nextgen/catalogue_filters
}}
{{#hascategories}}
    <nav class="ng-catalogue-filters" aria-label="{{#str}}categoriesheading, theme_nextgen{{/str}}">
        <a class="ng-chip{{#allactive}} is-active{{/allactive}}" href="{{allcoursesurl}}">{{#str}}allcourses, theme_nextgen{{/str}}</a>
        {{#categories}}
            <a class="ng-chip{{#active}} is-active{{/active}}" href="{{url}}">{{name}}</a>
        {{/categories}}
    </nav>
{{/hascategories}}
