{{!
    @template core_course/coursecard

    Course card used by My courses and other core course lists.
    Block slots stay in place so progress, menus, and favourites keep working.
}}
<div class="card course-card ng-course-card mx-1" role="listitem"
    data-region="course-content"
    data-course-id="{{{id}}}">
    <a href="{{viewurl}}" class="ng-course-media" tabindex="-1">
        <span class="card-img-top" style='background-image: url("{{{courseimage}}}");'>
            <span class="visually-hidden">{{fullname}}</span>
        </span>
    </a>
    <div class="card-body ng-course-body course-info-container" id="course-info-container-{{id}}-{{uniqid}}">
        <div class="ng-course-kicker">
            {{$coursecategory}}{{/coursecategory}}
        </div>
        {{#showshortname}}
            <div class="ng-course-shortname">
                <span class="visually-hidden">{{#str}}aria:courseshortname, core_course{{/str}}</span>
                {{{shortname}}}
            </div>
        {{/showshortname}}
        <a href="{{viewurl}}" class="aalink coursename ng-course-title">
            {{> core_course/favouriteicon }}
            <span class="visually-hidden">{{#str}}aria:coursename, core_course{{/str}}</span>
            {{$coursename}}{{/coursename}}
        </a>
        {{^visible}}
            <span class="badge text-bg-secondary">{{#str}}hiddenfromstudents{{/str}}</span>
        {{/visible}}
    </div>
    <div class="ng-course-meta">
        {{$progress}}{{/progress}}
        {{$menu}}{{/menu}}
    </div>
</div>
